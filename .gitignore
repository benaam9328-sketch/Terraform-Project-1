# Terraform local working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!example*.tfvars

# Terraform CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local SSH private keys
terra-server-project
terra-server-project.pub
*.pem

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
